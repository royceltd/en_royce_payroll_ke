  "font": null,
  "font_size": 14,
  "format_data": null,
  "html": "<style>\n  .royce-payslip { font-family: \"Helvetica Neue\", Arial, sans-serif; color: #1f2937; font-size: 10pt; }\n  .royce-payslip h1 { font-size: 18pt; margin: 0; color: #0b3d91; }\n  .royce-payslip .muted { color: #6b7280; }\n  .royce-payslip table { width: 100%; border-collapse: collapse; }\n  .royce-payslip .header-row td { vertical-align: top; padding-bottom: 14px; }\n  .royce-payslip .title-block { text-align: right; }\n  .royce-payslip .emp-table { margin: 14px 0; border: 1px solid #e5e7eb; }\n  .royce-payslip .emp-table td { padding: 6px 10px; border-bottom: 1px solid #e5e7eb; }\n  .royce-payslip .emp-table .label { color: #6b7280; font-size: 8.5pt; text-transform: uppercase; letter-spacing: 0.03em; }\n  .royce-payslip .emp-table .value { font-weight: 600; }\n  .royce-payslip .cols { margin-top: 6px; }\n  .royce-payslip .cols > td { width: 50%; vertical-align: top; padding: 0 8px; }\n  .royce-payslip .cols > td:first-child { padding-left: 0; }\n  .royce-payslip .comp-table th {\n    background: #0b3d91; color: #fff; text-align: left; padding: 6px 8px; font-size: 9pt; font-weight: 600;\n  }\n  .royce-payslip .comp-table td { padding: 5px 8px; border-bottom: 1px solid #e5e7eb; }\n  .royce-payslip .comp-table .num { text-align: right; }\n  .royce-payslip .comp-table .total-row td { font-weight: 700; border-top: 1px solid #9ca3af; border-bottom: none; }\n  .royce-payslip .statutory-highlight { color: #b91c1c; }\n  .royce-payslip .employer-section { margin-top: 16px; }\n  .royce-payslip .employer-section th {\n    background: #6b7280; color: #fff; text-align: left; padding: 6px 8px; font-size: 9pt; font-weight: 600;\n  }\n  .royce-payslip .net-pay-box {\n    margin-top: 18px; padding: 12px 16px; background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 4px;\n    display: flex; justify-content: space-between; align-items: center;\n  }\n  .royce-payslip .net-pay-box .label { font-size: 11pt; font-weight: 600; color: #0b3d91; }\n  .royce-payslip .net-pay-box .value { font-size: 16pt; font-weight: 700; color: #0b3d91; }\n  .royce-payslip .footer { margin-top: 24px; border-top: 1px solid #e5e7eb; padding-top: 10px; font-size: 8.5pt; color: #6b7280; }\n</style>\n\n{% set statutory = [\"PAYE\", \"NSSF Tier I - Employee\", \"NSSF Tier II - Employee\", \"SHIF\", \"Housing Levy\"] %}\n{% set employer_side = [\"NITA\", \"NSSF Employer\", \"Housing Levy Employer\"] %}\n{% set real_earnings = doc.earnings|rejectattr(\"salary_component\", \"in\", employer_side)|list %}\n{% set employer_rows = doc.earnings|selectattr(\"salary_component\", \"in\", employer_side)|list %}\n\n<div class=\"royce-payslip\">\n  <table class=\"header-row\">\n    <tr>\n      <td style=\"width: 55%;\">\n        <h1>{{ frappe.db.get_value(\"Company\", doc.company, \"company_name\") or doc.company }}</h1>\n        <div class=\"muted\">Payslip</div>\n      </td>\n      <td class=\"title-block\" style=\"width: 45%;\">\n        <div style=\"font-size: 13pt; font-weight: 600;\">\n          {{ frappe.utils.formatdate(doc.start_date, \"MMMM yyyy\") }}\n        </div>\n        <div class=\"muted\">Slip No. {{ doc.name }}</div>\n      </td>\n    </tr>\n  </table>\n\n  <table class=\"emp-table\">\n    <tr>\n      <td style=\"width: 25%;\"><div class=\"label\">Employee</div><div class=\"value\">{{ doc.employee_name }}</div></td>\n      <td style=\"width: 25%;\"><div class=\"label\">Employee ID</div><div class=\"value\">{{ doc.employee }}</div></td>\n      <td style=\"width: 25%;\"><div class=\"label\">Designation</div><div class=\"value\">{{ doc.designation or \"-\" }}</div></td>\n      <td style=\"width: 25%;\"><div class=\"label\">Department</div><div class=\"value\">{{ doc.department or \"-\" }}</div></td>\n    </tr>\n    <tr>\n      <td><div class=\"label\">Pay Period</div><div class=\"value\">\n        {{ frappe.utils.formatdate(doc.start_date) }} &ndash; {{ frappe.utils.formatdate(doc.end_date) }}\n      </div></td>\n      <td><div class=\"label\">Payment Date</div><div class=\"value\">{{ frappe.utils.formatdate(doc.posting_date) }}</div></td>\n      <td colspan=\"2\"><div class=\"label\">Bank Account</div><div class=\"value\">{{ doc.bank_account_no or \"-\" }}</div></td>\n    </tr>\n  </table>\n\n  <table class=\"cols\">\n    <tr>\n      <td>\n        <table class=\"comp-table\">\n          <thead><tr><th>Earnings</th><th class=\"num\">Amount</th></tr></thead>\n          <tbody>\n            {% for row in real_earnings %}\n            <tr><td>{{ row.salary_component }}</td><td class=\"num\">{{ frappe.utils.fmt_money(row.amount, currency=doc.currency) }}</td></tr>\n            {% endfor %}\n            <tr class=\"total-row\"><td>Gross Pay</td><td class=\"num\">{{ frappe.utils.fmt_money(doc.gross_pay, currency=doc.currency) }}</td></tr>\n          </tbody>\n        </table>\n      </td>\n      <td>\n        <table class=\"comp-table\">\n          <thead><tr><th>Deductions</th><th class=\"num\">Amount</th></tr></thead>\n          <tbody>\n            {% for row in doc.deductions %}\n            <tr{% if row.salary_component in statutory %} class=\"statutory-highlight\"{% endif %}>\n              <td>{{ row.salary_component }}</td><td class=\"num\">{{ frappe.utils.fmt_money(row.amount, currency=doc.currency) }}</td>\n            </tr>\n            {% endfor %}\n            <tr class=\"total-row\"><td>Total Deductions</td><td class=\"num\">{{ frappe.utils.fmt_money(doc.total_deduction, currency=doc.currency) }}</td></tr>\n          </tbody>\n        </table>\n      </td>\n    </tr>\n  </table>\n\n  {% if employer_rows %}\n  <table class=\"comp-table employer-section\">\n    <thead><tr><th>Employer Contributions (not part of your pay)</th><th class=\"num\">Amount</th></tr></thead>\n    <tbody>\n      {% for row in employer_rows %}\n      <tr><td>{{ row.salary_component }}</td><td class=\"num\">{{ frappe.utils.fmt_money(row.amount, currency=doc.currency) }}</td></tr>\n      {% endfor %}\n    </tbody>\n  </table>\n  {% endif %}\n\n  <div class=\"net-pay-box\">\n    <div class=\"label\">Net Pay</div>\n    <div class=\"value\">{{ frappe.utils.fmt_money(doc.net_pay, currency=doc.currency) }}</div>\n  </div>\n  <div class=\"muted\" style=\"text-align: right; margin-top: 4px; font-style: italic; font-size: 9pt;\">\n    {{ frappe.utils.money_in_words(doc.net_pay, doc.currency) }}\n  </div>\n\n  <div class=\"footer\">\n    Statutory deductions (PAYE, NSSF, SHIF, Housing Levy) are remitted to the relevant Kenyan authorities on your\n    behalf. This is a computer-generated payslip and is valid without a signature.\n  </div>\n</div>\n",
